# Copy this file to .env and fill it in. .env is git-ignored: never commit it.

# PostgreSQL connection string. For Supabase, download the CA certificate (Project Settings →
# Database → SSL configuration), save it as certs/supabase-ca.crt and append
#   ?sslmode=verify-full&sslrootcert=certs/supabase-ca.crt
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/stretch

# OAuth 2.0 "Web application" client ID from Google Cloud Console.
# The frontend uses the same value for Sign In With Google. Separate several with commas.
GOOGLE_CLIENT_ID=1234567890-abcdefg.apps.googleusercontent.com

# Signs session tokens. At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# How long a sign-in lasts before the user signs in with Google again.
JWT_EXPIRES_IN=7d

PORT=4000

# Frontend origin(s) allowed to call the API, comma-separated.
CORS_ORIGIN=http://localhost:3000

# Decides what "today" is when checking dates.
APP_TIMEZONE=Africa/Lagos
